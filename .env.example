# Afterword — copy to .env.local and fill in to run the Shopify install live.
# Create a Partner app at https://partners.shopify.com and paste its credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments
# Public HTTPS URL Shopify can reach (your deploy, or an ngrok/cloudflared tunnel in dev)
SHOPIFY_APP_URL=https://your-app.example.com

# Email sending for the follow-ups (wire src/lib/schedule.ts -> sendEmail)
RESEND_API_KEY=

# AI feedback analysis. With this set, the dashboard analyzes replies with Claude
# (claude-opus-4-8 by default; see src/lib/llm.ts). Without it, a deterministic
# fallback keeps everything working with zero setup.
ANTHROPIC_API_KEY=

# Billing (Shopify subscription — required before a public app can charge).
# Merchants are gated into a subscription right after install. Defaults give a
# $19/mo plan with a 7-day trial. SHOPIFY_BILLING_TEST=true creates a test charge
# (no real money) — leave it true for dev and App Store review, set false to charge.
SHOPIFY_PLAN_PRICE=19.00
SHOPIFY_PLAN_CURRENCY=USD
SHOPIFY_TRIAL_DAYS=7
SHOPIFY_BILLING_TEST=true

# Persistence. With this set, shop tokens and scheduled follow-ups are stored in
# Postgres and survive restarts (required for production/serverless). Without it, an
# in-memory store keeps everything working with zero setup (fine for local dev/tests).
# Use a pooled connection string (e.g. Neon's ...-pooler host). Tables are created
# automatically on first use; see schema.sql for the reference schema.
DATABASE_URL=
