# Afterword — copy to .env.local and fill in to run the Shopify install live.
# Create a Partner app at https://partners.shopify.com and paste its credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments
# Public HTTPS URL Shopify can reach (your deploy, or an ngrok/cloudflared tunnel in dev)
SHOPIFY_APP_URL=https://your-app.example.com

# Email sending for the follow-ups (wire src/lib/schedule.ts -> sendEmail)
RESEND_API_KEY=

# AI feedback analysis. With this set, the dashboard analyzes replies with Claude
# (claude-opus-4-8 by default; see src/lib/llm.ts). Without it, a deterministic
# fallback keeps everything working with zero setup.
ANTHROPIC_API_KEY=
