# Copy to .env.local for local development. `npm run demo` works with no file at all.

# Prisma database. SQLite for local dev; on Vercel add a Neon Postgres store and the build
# switches the provider automatically.
DATABASE_URL="file:./dev.db"

# Where uploaded invoices, generated CSVs and images are stored on local disk.
STORAGE_DIR=./storage

# Public HTTPS origin of this app, used to build image URLs Shopify can fetch (can also be set
# in Settings). Not needed on Vercel with a Blob store.
APP_PUBLIC_URL=

# Vercel: add a Blob store to the project (Storage → Blob); this token is injected automatically
# and switches file storage from local disk to Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Claude API key: enables PDF/scan/photo invoice extraction and AI product copy. Without it,
# CSV/XLSX imports and template copy still work.
ANTHROPIC_API_KEY=
# Optional: override the models. CATALOG_AI_MODEL reads supplier documents and checks a batch
# (the strongest); the working model researches, reads pages, plans and writes copy; the light
# model turns notes into fields and screens lists.
CATALOG_AI_MODEL=claude-opus-5-5
CATALOG_AI_WORKING_MODEL=claude-sonnet-5-5
CATALOG_AI_LIGHT_MODEL=claude-haiku-5-5
# Optional: read photographed and scanned invoices at fast speed — quicker, at twice the price.
# CATALOG_FAST_READS=1
